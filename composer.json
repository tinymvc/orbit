{
    "name": "tinymvc/orbit",
    "type": "project",
    "description": "A lightweight, fast and flexible admin dashboard built on TinyMVC + Inertia.js + React + Shadcn.",
    "keywords": ["shahinmoyshan", "tinymvc", "orbit", "dashboard", "admin panel", "starter kit", "php", "web development"],
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "tinymvc/tinycore": "^2.3",
        "tinymvc/inertia-php": "^1.0",
        "phpmailer/phpmailer": "^7.0",
        "voku/portable-ascii": "^2.0"
    },
    "authors": [
        {
            "name": "Shahin Moyshan",
            "email": "shahin.moyshan2@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "./app"
        },
        "files": [
            "./bootstrap/helpers.php"
        ]
    },
    "suggest": {
        "phpmailer/phpmailer": "Required for sending emails (^6.9).",
        "league/commonmark": "Required to use Str::markdown() and Stringable::markdown() (^2.6).",
        "voku/portable-ascii": "Required to use on Str::slug() with non-english strings (^2.0).,",
        "ramsey/uuid": "Required to use Str::uuid() (^4.7)."
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php spark key:generate",
            "@php spark storage:link",
            "@php spark migrate --seed"
        ]
    },
    "config": {
        "optimize-autoloader": true
    }
}
